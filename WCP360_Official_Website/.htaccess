<IfModule mod_rewrite.c>
RewriteEngine On

# Un seul hôte public pour éviter les doublons SEO entre www et non-www.
RewriteCond %{HTTP_HOST} !^www\.nettoyage360\.fr$ [NC]
RewriteRule ^ https://www.nettoyage360.fr%{REQUEST_URI} [L,R=301,NE]

# HTTPS, y compris lorsque PlanetHoster transmet le protocole via son proxy.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://www.nettoyage360.fr%{REQUEST_URI} [L,R=301,NE]

# Les fichiers index restent internes : leur URL publique est celle du dossier.
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html(?:[?\s]) [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L,NE]

# Les pages locales et légales sont rangées dans des dossiers de maintenance,
# tout en conservant leurs URL canoniques historiques à la racine. Un accès
# direct au chemin physique est normalisé, puis l'URL publique est servie sans
# redirection supplémentaire.
RewriteCond %{THE_REQUEST} \s/+zones-intervention/nettoyage-[^/?\s]+\.html(?:[?\s]) [NC]
RewriteRule ^zones-intervention/(nettoyage-[^/]+)\.html$ /$1 [R=301,L,NE]

# Les anciens chemins physiques sans extension pointent aussi vers l'URL canonique.
RewriteCond %{THE_REQUEST} \s/+zones-intervention/nettoyage-[^/?\s]+/?(?:[?\s]) [NC]
RewriteRule ^zones-intervention/(nettoyage-[^/]+)/?$ /$1 [R=301,L,NE]

RewriteCond %{THE_REQUEST} \s/+legale/(mentions-legales|politique-confidentialite|politique-cookies|gestion-cookies|cgv)\.html(?:[?\s]) [NC]
RewriteRule ^legale/([^/]+)\.html$ /$1 [R=301,L,NE]

# Toute ancienne URL publique avec .html est normalisée en une seule redirection.
RewriteCond %{THE_REQUEST} \s/+[^?\s]+\.html(?:[?\s]) [NC]
RewriteRule ^(.+)\.html$ /$1 [R=301,L,NE]

# Une page statique possede une URL canonique sans barre oblique finale.
# Cette normalisation empeche la resolution des ressources comme si la page
# etait un dossier (par exemple /devis/assets/...).
RewriteCond %{DOCUMENT_ROOT}/legale/$1.html -f
RewriteRule ^(mentions-legales|politique-confidentialite|politique-cookies|gestion-cookies|cgv)/$ /$1 [R=301,L,NE]

RewriteCond %{DOCUMENT_ROOT}/zones-intervention/$1.html -f
RewriteRule ^(nettoyage-[a-z0-9-]+)/$ /$1 [R=301,L,NE]

RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)/$ /$1 [R=301,L,NE]

RewriteCond %{DOCUMENT_ROOT}/legale/$1.html -f
RewriteRule ^(mentions-legales|politique-confidentialite|politique-cookies|gestion-cookies|cgv)$ legale/$1.html [L]

RewriteCond %{DOCUMENT_ROOT}/zones-intervention/$1.html -f
RewriteRule ^(nettoyage-[a-z0-9-]+)$ zones-intervention/$1.html [L]

# Les URL propres sont reliées silencieusement aux fichiers statiques existants.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
Header always set Cross-Origin-Opener-Policy "same-origin"
Header always set Strict-Transport-Security "max-age=31536000"
Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'"
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/avif "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType text/css "access plus 7 days"
ExpiresByType application/javascript "access plus 7 days"
</IfModule>

<FilesMatch "\\.(md|csv|json|log|conf)$">
Require all denied
</FilesMatch>

# Les paramètres de messagerie restent exécutables par PHP mais inaccessibles en HTTP.
<FilesMatch "^config(?:\.local(?:\.example)?)?\.php$">
Require all denied
</FilesMatch>
