{
  "version": "v1.0",
  "source_path": "specifications/security/WCP360_Security_Baseline_v1.0_CANONICAL_IMPLEMENTATION_EXPORT.md",
  "source_blob_sha": "6d74f2f363524511424f839ca7262143c2af95ab",
  "invariant": "WCP-USER session != WCP-ADMIN session",
  "cookie_user": "__Host-wcp_user_session",
  "cookie_admin": "__Host-wcp_admin_session",
  "required_cookie_attributes": [
    "Secure",
    "HttpOnly",
    "SameSite=Strict",
    "Path=/",
    "host-only",
    "no Domain attribute"
  ],
  "policies": [
    {
      "policy": "cookie",
      "wcp_user": "__Host-wcp_user_session",
      "wcp_admin": "__Host-wcp_admin_session"
    },
    {
      "policy": "idle timeout",
      "wcp_user": "30 min",
      "wcp_admin": "15 min"
    },
    {
      "policy": "absolute lifetime",
      "wcp_user": "12 h",
      "wcp_admin": "8 h"
    },
    {
      "policy": "remember-me",
      "wcp_user": "disabled baseline",
      "wcp_admin": "forbidden"
    },
    {
      "policy": "MFA at login",
      "wcp_user": "policy/account dependent",
      "wcp_admin": "mandatory"
    },
    {
      "policy": "fresh MFA high-risk",
      "wcp_user": "<=10 min when required",
      "wcp_admin": "<=5 min"
    },
    {
      "policy": "privileged child context",
      "wcp_user": "unavailable",
      "wcp_admin": "idle 5 min / absolute 15 min"
    },
    {
      "policy": "break-glass",
      "wcp_user": "unavailable",
      "wcp_admin": "max 15 min, no auto-extension"
    }
  ]
}
