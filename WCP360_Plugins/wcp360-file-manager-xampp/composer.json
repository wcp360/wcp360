{
  "name": "wcp360/file-manager",
  "description": "Standalone and embeddable file manager for Symfony",
  "type": "symfony-bundle",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "ext-json": "*",
    "ext-fileinfo": "*",
    "symfony/framework-bundle": "^7.4",
    "symfony/security-bundle": "^7.4",
    "symfony/security-csrf": "^7.4",
    "symfony/monolog-bundle": "^3.10",
    "symfony/rate-limiter": "^7.4",
    "symfony/yaml": "^7.4",
    "symfony/lock": "^7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "symfony/browser-kit": "^7.4",
    "symfony/css-selector": "^7.4"
  },
  "autoload": {
    "psr-4": {
      "Wcp360\\FileManager\\": "src/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "find src standalone tests -name \"*.php\" -print0 | xargs -0 -n1 php -l"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.2.0"
    }
  },
  "conflict": {
    "symfony/cache": ">=8.0",
    "symfony/clock": ">=8.0",
    "symfony/error-handler": ">=8.0",
    "symfony/filesystem": ">=8.0",
    "symfony/finder": ">=8.0",
    "symfony/http-foundation": ">=8.0",
    "symfony/options-resolver": ">=8.0",
    "symfony/password-hasher": ">=8.0",
    "symfony/property-access": ">=8.0",
    "symfony/property-info": ">=8.0",
    "symfony/routing": ">=8.0",
    "symfony/security-core": ">=8.0",
    "symfony/string": ">=8.0",
    "symfony/type-info": ">=8.0",
    "symfony/var-dumper": ">=8.0",
    "symfony/var-exporter": ">=8.0",
    "symfony/dom-crawler": ">=8.0"
  }
}
