# Development candidate only. Copy to .env; generate a unique APP_SECRET.
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=replace-with-a-random-local-secret
# Separate 32-byte hexadecimal MFA encryption key, supplied privately by operator.
# Empty blocks MFA enrollment and enabled-factor accounts; password-only access remains available.
WCP_MFA_KEY=
WCP_CANDIDATE=1
WCP_CONTEXT=user
WCP_PUBLIC_HOST=user.localhost
# Shared development access only. See config/contexts/DATABASE-PROFILES.md.
WCP_DATABASE_MODE=shared
# Explicit maintenance-only fresh role creation for disposable development databases.
WCP_ALLOW_CANDIDATE_DATABASE_ROLES=0
# Setup-only operator password recovery; never expose this flag or maintenance URL to web/worker processes.
WCP_ALLOW_CANDIDATE_ACCOUNT_RECOVERY=0
# Shared-profile recovery codes: two independent random 32-byte hex keys.
# Leave both empty in a shared .env; inject only the matching key into each process.
# USER receives only its key, ADMIN only its key; setup receives the key for its requested target.
WCP_ALLOW_CANDIDATE_RECOVERY_CODES=0
WCP_RECOVERY_USER_KEY=
WCP_RECOVERY_ADMIN_KEY=
DATABASE_URL="sqlite:///%kernel.project_dir%/var/workbench.db"
# Opt-in session isolation uses only WCP_DATABASE_<CONTEXT>_URL supplied privately.
# Keep other runtime credentials and the setup/migration credential out of web environments.
WCP_PLANNER="%kernel.project_dir%/var/bin/wcp-plan"
# Experimental hosted-site planning only; does not change the Core HTTP runtime.
WCP_ALLOW_FRANKENPHP_PLANS=0
# Explicit isolated-container activation only; never enables production hosting.
WCP_ALLOW_ISOLATED_PROVISIONING=0
