# Development candidate only. Copy to .env; generate a unique APP_SECRET.
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=replace-with-a-random-local-secret
WCP_CANDIDATE=1
WCP_CONTEXT=user
WCP_PUBLIC_HOST=user.localhost
DATABASE_URL="sqlite:///%kernel.project_dir%/var/workbench.db"
WCP_PLANNER="%kernel.project_dir%/var/bin/wcp-plan"
# Experimental hosted-site planning only; does not change the Core HTTP runtime.
WCP_ALLOW_FRANKENPHP_PLANS=0
# Explicit isolated-container activation only; never enables production hosting.
WCP_ALLOW_ISOLATED_PROVISIONING=0
