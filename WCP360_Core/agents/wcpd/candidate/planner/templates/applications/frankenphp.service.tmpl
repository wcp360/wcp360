# Inert classic-PHP service; not installed or started by the preview.
[Unit]
Description=WCP360 candidate PHP application {{.ID}}
After=network.target
[Service]
Type=simple
User={{.User}}
Group={{.User}}
WorkingDirectory={{.Root}}
ExecStart=/usr/local/bin/frankenphp run --config /var/lib/wcp360-candidate/applications/{{.ID}}/Caddyfile --adapter caddyfile
Environment=XDG_CONFIG_HOME=/var/lib/wcp360-applications/{{.ID}}/config
Environment=XDG_DATA_HOME=/var/lib/wcp360-applications/{{.ID}}/data
RuntimeDirectory=wcp360-applications/{{.ID}}
RuntimeDirectoryMode=0750
StateDirectory=wcp360-applications/{{.ID}}
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=3
TimeoutStopSec=60
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ReadWritePaths={{.Root}} {{.Root}}/../var {{.Root}}/../tmp -{{.Root}}/../storage -{{.Root}}/../bootstrap/cache
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryMax=768M
TasksMax=64
[Install]
WantedBy=multi-user.target
