{% extends 'layouts/workbench.html.twig' %}{% set page_title = 'Connexion' %}{% block content %}<section class="login-card card"><p class="eyebrow">ESPACE {{ context|upper }}</p><h1>Bienvenue sur WCP360</h1><p class="muted">Connectez-vous avec un compte créé par le wizard local.</p>{% if error %}<p role="alert" class="error">Connexion refusée. Vérifiez vos identifiants et le contexte.</p>{% endif %}<form method="post" action="{{ path('wcp_login') }}" data-turbo="false"><label for="username">Adresse e-mail</label><input id="username" name="_username" type="email" required maxlength="254" autocomplete="username"><label for="password">Mot de passe</label><input id="password" name="_password" type="password" required maxlength="256" autocomplete="current-password"><input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}"><button class="button" type="submit">Se connecter</button></form></section>{% endblock %}
