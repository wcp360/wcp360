{% extends 'layouts/workbench.html.twig' %}{% set page_title = 'Tableau de bord' %}{% block content %}
<div class="page-heading"><div><p class="eyebrow">VOTRE INFRASTRUCTURE</p><h1>Tableau de bord</h1><p class="muted">Un socle modulaire, des opérations traçables.</p></div><span class="context">{{ context|upper }}</span></div>
{% if context == 'admin' %}<section id="runtime" class="card"><h2>Serveur d’application par défaut</h2><p class="muted">Ce réglage concerne les nouveaux plans des sites hébergés. Les sites existants et le runtime du panneau conservent leur configuration.</p><form method="post" action="{{ path('wcp_application_server') }}"><input type="hidden" name="_token" value="{{ csrf_token('application-server') }}"><input type="hidden" name="revision" value="{{ runtime_settings.revision }}">{% include 'components/forms/application-server.html.twig' with {field_id:'default-application-server',allow_inherit:false,selected:runtime_settings.application_server} %}<button class="button" type="submit">Enregistrer le défaut</button></form></section><section id="plugins" class="card"><h2>Extensions détachées</h2><p class="muted">Le paquet de référence traite uniquement un résumé explicitement fourni. Son code ne s’exécute pas dans le Core.</p>{% for plugin in plugins %}<div class="plugin-row"><div><strong>{{ plugin.id }}</strong><p>{{ plugin.version }} · {% include 'components/feedback/status.html.twig' with {state: plugin.state} only %}</p></div><div class="actions">{% for action in plugin.state == 'ENABLED' ? ['disable'] : ['enable','uninstall'] %}<form method="post" action="{{ path('wcp_plugin',{action:action}) }}"><input type="hidden" name="_token" value="{{ csrf_token('plugin-' ~ action) }}"><button class="button secondary" type="submit">{{ {enable:'Activer',disable:'Désactiver',uninstall:'Désinstaller'}[action] }}</button></form>{% endfor %}</div></div>{% else %}<p>Aucune extension installée. Le Core reste opérationnel.</p><form method="post" action="{{ path('wcp_plugin',{action:'install'}) }}"><input type="hidden" name="_token" value="{{ csrf_token('plugin-install') }}"><button class="button" type="submit">Installer le rapport de référence</button></form>{% endfor %}</section>
{% else %}<div class="metrics"><div class="card metric"><span>Espaces accessibles</span><strong>{{ tenants|length }}</strong><small>Autorisations vérifiées en base</small></div><div class="card metric"><span>Tâches affichées</span><strong>{{ jobs|length }}</strong><small>Les 100 plus récentes</small></div><div class="card metric"><span>Exécution système</span><strong class="text-small">Plan uniquement</strong><small>Validation Linux avant application</small></div></div>
{% if tenants %}<div class="content-grid"><section class="card"><h2>Préparer un hébergement</h2><p class="muted">Préparer une configuration Nginx avec PHP-FPM ou FrankenPHP Worker pour un domaine de test.</p><form method="post" action="{{ path('wcp_plan') }}" data-controller="form-guard" data-action="submit->form-guard#submit"><input type="hidden" name="_token" value="{{ csrf_token('hosting-plan') }}"><input type="hidden" name="idempotency_key" value="{{ idempotency_key }}"><label for="tenant">Espace</label><select id="tenant" name="tenant_id">{% for item in tenants %}<option value="{{ item.id }}" {% if item.id == tenant %}selected{% endif %}>{{ item.name }}</option>{% endfor %}</select><label for="hostname">Nom de domaine</label><input id="hostname" name="hostname" required maxlength="253" pattern="[a-z0-9.-]+\.test" placeholder="mon-site.test" autocomplete="off"><p class="field-help">Domaine ASCII en minuscules, se terminant par .test.</p>{% include 'components/forms/application-server.html.twig' with {field_id:'site-application-server',allow_inherit:true,selected:'inherit'} %}<label class="checkbox-row"><input type="checkbox" name="worker_acknowledged" value="1"{% if not worker_plans_enabled %} disabled{% endif %}> Je confirme que cette application est compatible avec le mode worker et réinitialise son état entre les requêtes.</label><p class="field-help">Confirmation obligatoire si le mode worker est sélectionné ou hérité. Un plan ne déploie ni service ni application.</p><button class="button" type="submit" data-form-guard-target="button">Générer le plan</button><p class="field-help" role="status" data-form-guard-target="status"></p></form></section><section id="jobs" class="card"><h2>Dernières tâches</h2><div class="table-scroll"><table><caption class="sr-only">Tâches du tenant sélectionné</caption><thead><tr><th scope="col">Domaine</th><th scope="col">Serveur</th><th scope="col">État</th><th scope="col">Détail</th></tr></thead><tbody>{% for job in jobs %}<tr><td>{{ job.hostname }}</td><td>{{ job.application_server == 'php_fpm' ? 'PHP-FPM' : 'FrankenPHP Worker' }}</td><td>{% include 'components/feedback/status.html.twig' with {state:job.state} only %}</td><td><a href="{{ path('wcp_job',{id:job.id}) }}">Consulter<span class="sr-only"> {{ job.hostname }}</span></a></td></tr>{% else %}<tr><td colspan="4" class="empty">Aucune tâche. Préparez votre premier hébergement.</td></tr>{% endfor %}</tbody></table></div></section></div>{% else %}<section class="card"><h2>Aucun espace autorisé</h2><p>Demandez une affectation à l’administrateur local.</p></section>{% endif %}{% endif %}{% endblock %}
