{% extends 'layouts/workbench.html.twig' %}
{% set page_title = 'Suivi de tâche' %}
{% block content %}
<div class="page-heading"><div><p class="eyebrow">OPÉRATIONS</p><h1>Suivi de tâche</h1><p class="mono">{{ job.id }}</p></div>{% include 'components/feedback/status.html.twig' with {state:job.state} only %}</div>
<section class="card">
<dl>
<dt>Serveur retenu</dt><dd>{{ job.application_server == 'php_fpm' ? 'PHP-FPM' : 'FrankenPHP Worker' }}</dd>
<dt>Référence de création</dt><dd>{% if job.request_id %}<code data-origin-request-id>{{ job.request_id }}</code>{% else %}<span class="muted">Non disponible pour cette tâche antérieure</span>{% endif %}</dd>
<dt>Créée</dt><dd>{{ job.created_at }}</dd>
<dt>Démarrée</dt><dd>{{ job.started_at|default('En attente') }}</dd>
<dt>Terminée</dt><dd>{{ job.completed_at|default('En attente') }}</dd>
</dl>
{% if plan_files %}
<h2>Fichiers du plan</h2>
<p class="muted">Ces fichiers décrivent la préparation. Leur consultation ou téléchargement n’applique aucune configuration.</p>
{% for key,file in plan_files %}
<section data-plan-artifact="{{ key }}"><h3>{{ file.label }}</h3>
<p><a class="button secondary" data-turbo="false" href="{{ path('wcp_plan_file',{id:job.id,artifact:key}) }}">Télécharger {{ file.name }}</a></p>
<pre><code>{{ file.content }}</code></pre>
</section>
{% endfor %}
{% elseif job.state == 'UNKNOWN_OUTCOME' %}
<p role="alert">Tâche interrompue. Une réconciliation est requise avant toute nouvelle tentative.</p>
{% elseif job.state == 'FAILED' %}
<p role="alert">Le plan n’a pas pu être généré. Vérifiez le worker, les droits et le binaire Go.</p>
{% else %}
<p>Le worker traitera la tâche. Actualisez cette page pour consulter son état.</p>
{% endif %}
{% if activation %}
<h2>Activation Linux d’essai</h2><p>État observé : <strong>{{ activation.state }}</strong></p>
{% if activation.state == 'UNKNOWN_OUTCOME' %}<p role="alert">Vérification requise par l’opérateur. Aucune nouvelle application automatique.</p>{% endif %}
{% elseif provisioning_enabled and job.state == 'SUCCEEDED' and job.application_server == 'php_fpm' %}
<form method="post" action="{{ path('wcp_activate',{id:job.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('activate-' ~ job.id) }}"><button class="button" type="submit">Activer dans le conteneur d’essai</button><p class="field-help">Crée un site PHP-FPM réel dans l’environnement isolé. Cette action ne constitue pas un déploiement de production.</p></form>
{% endif %}
<a class="button secondary" href="{{ path('wcp_job',{id:job.id}) }}">Actualiser</a>
<a class="button secondary" href="{{ path('wcp_jobs') }}">Toutes mes tâches</a>
<a href="{{ path('wcp_dashboard') }}">Retour au tableau de bord</a>
</section>
{% endblock %}
