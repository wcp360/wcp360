{% extends 'layouts/workbench.html.twig' %}{% set page_title = 'Suivi de tâche' %}{% block content %}<div class="page-heading"><div><p class="eyebrow">OPÉRATIONS</p><h1>Suivi de tâche</h1><p class="mono">{{ job.id }}</p></div>{% include 'components/feedback/status.html.twig' with {state:job.state} only %}</div><section class="card"><dl><dt>Serveur retenu</dt><dd>{{ job.application_server == 'php_fpm' ? 'PHP-FPM' : 'FrankenPHP Worker' }}</dd><dt>Créée</dt><dd>{{ job.created_at }}</dd><dt>Démarrée</dt><dd>{{ job.started_at|default('En attente') }}</dd><dt>Terminée</dt><dd>{{ job.completed_at|default('En attente') }}</dd></dl>{% if job.result %}<h2>Plan généré</h2><pre><code>{{ job.result }}</code></pre><p class="muted">Résultat de préparation uniquement. Le site n’a pas été activé.</p>{% elseif job.state == 'UNKNOWN_OUTCOME' %}<p role="alert">Tâche interrompue. Une réconciliation est requise avant toute nouvelle tentative.</p>{% elseif job.state == 'FAILED' %}<p role="alert">Le plan n’a pas pu être généré. Vérifiez le worker, les droits et le binaire Go.</p>{% else %}<p>Le worker traitera la tâche. Actualisez cette page pour consulter son état.</p>{% endif %}<a class="button secondary" href="{{ path('wcp_job',{id:job.id}) }}">Actualiser</a> <a href="{{ path('wcp_dashboard') }}">Retour au tableau de bord</a></section>{% endblock %}
