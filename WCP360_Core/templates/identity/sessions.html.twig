{% extends 'layouts/workbench.html.twig' %}
{% block content %}
<h1>Mes sessions</h1><p>Consultez les sessions de votre compte dans le contexte {{ context|upper }}. Les autres contrôles de compte et de MFA continuent de s’appliquer.</p>
<p>Les facteurs validés indiquent comment chaque session a été authentifiée. Une session en attente de MFA ne donne pas accès au panneau.</p>
<p>Une révocation bloque les prochaines requêtes. Elle n’arrête pas une opération déjà transmise au système.</p>
<section class="card"><div class="table-scroll"><table><caption>Sessions de mon compte</caption><thead><tr><th scope="col">Session</th><th scope="col">Créée</th><th scope="col">Dernière activité</th><th scope="col">Expiration maximale</th><th scope="col">Facteurs validés</th><th scope="col">État</th><th scope="col">Action</th></tr></thead><tbody>
{% for entry in report.items %}<tr data-session-id="{{ entry.id }}"><td>{{ entry.current ? 'Cette session' : 'Autre session' }}</td><td>{{ entry.created_at|date('d/m/Y H:i:s') }}</td><td>{{ entry.last_seen_at|date('d/m/Y H:i:s') }}</td><td>{{ entry.expires_at|date('d/m/Y H:i:s') }}</td><td data-session-strength>{{ entry.auth_strength == 2 ? 'Mot de passe + MFA' : 'Mot de passe' }}</td><td data-session-state>{{ {active:'Active',pending:'MFA en attente',expired:'Expirée',revoked:'Révoquée'}[entry.state]|default('Indisponible') }}</td><td>
{% if entry.revoked_at is null %}<form action="{{ path('wcp_sessions_revoke', {id: entry.id}) }}" method="post" data-turbo-frame="_top"><input type="hidden" name="_token" value="{{ csrf_token('session_revoke_' ~ entry.id) }}"><label for="password-{{ entry.id }}">Mot de passe courant</label><input id="password-{{ entry.id }}" name="current_password" type="password" autocomplete="current-password" maxlength="256" required><button class="button secondary" type="submit">Déconnecter</button></form>{% else %}—{% endif %}
</td></tr>{% else %}<tr><td colspan="7">Aucune session à afficher.</td></tr>{% endfor %}
</tbody></table></div></section>
<nav aria-label="Pages des sessions"><span>Page {{ report.page }}</span>{% if report.page > 1 %} <a href="{{ path('wcp_account_sessions', {page: report.page - 1}) }}">Précédente</a>{% endif %}{% if report.has_next and report.page < 10000 %} <a href="{{ path('wcp_account_sessions', {page: report.page + 1}) }}">Suivante</a>{% endif %}</nav>
<section class="card"><h2>Déconnexion globale</h2><p>Cette action ferme aussi la session actuelle, dans ce contexte. Cinq confirmations de mot de passe sont autorisées par session sur quinze minutes.</p><form action="{{ path('wcp_sessions_revoke_all') }}" method="post" data-turbo-frame="_top"><input type="hidden" name="_token" value="{{ csrf_token('session_revoke_all') }}"><label for="password-all">Mot de passe courant</label><input id="password-all" name="current_password" type="password" autocomplete="current-password" maxlength="256" required><button class="button" type="submit">Tout déconnecter</button></form></section>
{% endblock %}
