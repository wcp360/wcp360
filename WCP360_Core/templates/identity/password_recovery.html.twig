{% extends 'layouts/auth.html.twig' %}
{% set page_title = 'Récupération du mot de passe' %}
{% block content %}
<p class="auth-eyebrow">{{ context == 'admin' ? 'ESPACE ADMINISTRATEUR' : 'ESPACE D’HÉBERGEMENT' }}</p>
<h1>Retrouvez votre accès</h1>
<p class="auth-lead">Utilisez le code temporaire remis par l’opérateur de votre instance.</p>
{% if not available %}
<p role="status" class="auth-feedback">La récupération par code n’est pas activée sur cette instance. Contactez votre opérateur.</p>
{% else %}
{% if error %}<p role="alert" class="auth-feedback error">{{ error }}</p>{% endif %}
<form class="auth-form" method="post" action="{{ path('wcp_password_recovery_complete') }}" data-turbo="false">
    <div><label for="recovery-code">Code de récupération</label><input id="recovery-code" name="recovery_code" type="password" required maxlength="220" autocomplete="off" autocapitalize="none" spellcheck="false" aria-describedby="recovery-code-help"><p id="recovery-code-help" class="field-help">Valable 15 minutes, pour ce compte et cet espace uniquement. Collez le code complet.</p></div>
    <div><label for="new-password">Nouveau mot de passe</label><input id="new-password" name="new_password" type="password" required minlength="14" maxlength="256" autocomplete="new-password"></div>
    <div><label for="repeat-password">Confirmer le nouveau mot de passe</label><input id="repeat-password" name="repeat_password" type="password" required minlength="14" maxlength="256" autocomplete="new-password"></div>
    <input type="hidden" name="_token" value="{{ csrf_token('password_recovery') }}">
    <button class="button auth-submit" type="submit">Réinitialiser le mot de passe</button>
</form>
<p class="auth-help">Les sessions de votre compte seront fermées. Votre MFA restera activée si vous l’avez configurée ; reconnectez-vous ensuite normalement.</p>
{% endif %}
<p class="auth-help"><a href="{{ path('wcp_login') }}" data-turbo-frame="_top">Retour à la connexion</a></p>
{% endblock %}
