{% set page_title = page_title|default('WCP360') %}
<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>{{ page_title }} · WCP360</title><link rel="stylesheet" href="{{ asset('styles/app.css') }}">{{ importmap('app', {nonce: app.request.attributes.get('_csp_nonce')}) }}</head><body>
<a class="skip" href="#main">Aller au contenu</a>
<div class="shell"><aside class="sidebar"><a class="brand" href="{{ path('wcp_dashboard') }}"><span class="brand-icon">W</span> WCP<span>360</span></a><p class="eyebrow">CONTROL PANEL</p><nav aria-label="Navigation principale"><a href="{{ path('wcp_dashboard') }}" aria-current="page">Vue d’ensemble</a>{% if app.user %}{% if context == 'admin' %}<a href="{{ path('wcp_dashboard') }}#runtime">Serveurs d’application</a><a href="{{ path('wcp_account_security') }}">Sécurité du compte</a><a href="{{ path('wcp_access_permissions') }}">Accès des utilisateurs</a>{% endif %}<a href="{{ path('wcp_dashboard') }}#{{ context == 'admin' ? 'plugins' : 'jobs' }}">{{ context == 'admin' ? 'Extensions' : 'Tâches' }}</a>{% endif %}</nav><div class="sidebar-note"><span class="dot"></span> Développement local<p>Contexte {{ context|upper }}</p></div></aside>
<div class="workspace"><header><span class="breadcrumb">WCP360 / {{ context|upper }}</span>{% if app.user %}<form action="{{ path('wcp_logout') }}" method="post" data-turbo="false"><input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}"><button class="button secondary" type="submit">Déconnexion</button></form>{% endif %}</header><main id="main" tabindex="-1"><div class="notice"><strong>Version de développement</strong><span>Plans et opérations suivis. L’activation Linux reste réservée au conteneur d’essai isolé.</span></div>{% block content %}{% endblock %}</main><footer>WCP360 · Core indépendant des extensions <span>PHP / Symfony · Go</span></footer></div></div></body></html>
