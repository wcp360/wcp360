{% macro icon(name, extra = '') %}
<svg class="wcp-icon {{ extra }}" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
{% if name == 'menu' %}<path d="M4 6h16M4 12h16M4 18h16"/>
{% elseif name == 'dashboard' %}<rect x="3" y="3" width="7" height="7" rx="2"/><rect x="14" y="3" width="7" height="7" rx="2"/><rect x="3" y="14" width="7" height="7" rx="2"/><rect x="14" y="14" width="7" height="7" rx="2"/>
{% elseif name == 'globe' %}<circle cx="12" cy="12" r="9"/><ellipse cx="12" cy="12" rx="4" ry="9"/><path d="M3 12h18"/>
{% elseif name == 'server' %}<rect x="3" y="3" width="18" height="7" rx="2"/><rect x="3" y="14" width="18" height="7" rx="2"/><path d="M7 6.5h.01M7 17.5h.01M12 6.5h5M12 17.5h5"/>
{% elseif name == 'search' %}<circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/>
{% elseif name == 'shield' %}<path d="m12 3 8 3v6c0 5-8 9-8 9s-8-4-8-9V6z"/><path d="m8 12 3 3 5-6"/>
{% elseif name == 'sessions' %}<rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8M12 17v4"/>
{% elseif name == 'users' %}<circle cx="9" cy="8" r="3"/><path d="M3 21v-2a6 6 0 0 1 12 0v2M16 5a3 3 0 0 1 0 6M18 15a5 5 0 0 1 3 4v2"/>
{% elseif name == 'package' %}<path d="m12 3 9 5v9l-9 5-9-5V8zM3 8l9 5 9-5M12 13v9M8 5l9 5"/>
{% elseif name == 'clock' %}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
{% elseif name == 'plus' %}<path d="M12 5v14M5 12h14"/>
{% elseif name == 'arrow' %}<path d="M5 12h14m-6-6 6 6-6 6"/>
{% elseif name == 'logout' %}<path d="M9 4H4v16h5M9 12h12m-4-4 4 4-4 4"/>
{% elseif name == 'sun' %}<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1 1M18 18l1 1M5 19l1-1M18 6l1-1"/>
{% elseif name == 'moon' %}<path d="M21 13a9 9 0 0 1-10-10 9 9 0 1 0 10 10Z"/>
{% elseif name == 'check' %}<path d="m5 12 4 4L19 6"/>
{% elseif name == 'close' %}<path d="m6 6 12 12M6 18 18 6"/>
{% else %}<circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 17h.01"/>
{% endif %}
</svg>
{% endmacro %}
