{
  "name": "wcp360/core",
  "type": "project",
  "description": "WCP360 executable development candidate",
  "license": "proprietary",
  "require": {
    "php": "~8.4.0",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "ext-pdo": "*",
    "ext-sodium": "*",
    "symfony/framework-bundle": "7.4.*",
    "symfony/console": "7.4.*",
    "symfony/dotenv": "7.4.*",
    "symfony/security-bundle": "7.4.*",
    "symfony/security-csrf": "7.4.*",
    "symfony/rate-limiter": "7.4.*",
    "symfony/twig-bundle": "7.4.*",
    "symfony/validator": "7.4.*",
    "symfony/uid": "7.4.*",
    "symfony/asset": "7.4.*",
    "symfony/yaml": "7.4.*",
    "symfony/asset-mapper": "7.4.*",
    "symfony/stimulus-bundle": "^2.20",
    "symfony/ux-turbo": "^2.20",
    "doctrine/dbal": "^4.3",
    "doctrine/orm": "^3.4",
    "doctrine/doctrine-bundle": "^2.18",
    "doctrine/doctrine-migrations-bundle": "^3.4",
    "symfony/process": "7.4.*",
    "ext-intl": "*",
    "ext-mbstring": "*",
    "ext-pdo_pgsql": "*",
    "ext-openssl": "*"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.3",
    "phpunit/phpunit": "^12.0",
    "symfony/browser-kit": "7.4.*",
    "symfony/css-selector": "7.4.*",
    "symfony/panther": "^2.4",
    "symfony/test-pack": "^1.2"
  },
  "autoload": {
    "psr-4": {
      "Wcp360\\Core\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wcp360\\Core\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {},
    "sort-packages": true
  },
  "scripts": {
    "test": "@php vendor/phpunit/phpunit/phpunit",
    "check": [
      "@analyse",
      "@test",
      "@php bin/console lint:container",
      "@php bin/console lint:yaml config",
      "@php bin/console lint:twig templates"
    ],
    "analyse": "@php vendor/phpstan/phpstan/phpstan analyse --no-progress",
    "test:browser": "@php vendor/phpunit/phpunit/phpunit -c phpunit.browser.xml"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "conflict": {
    "symfony/clock": ">=8.0",
    "symfony/error-handler": ">=8.0",
    "symfony/filesystem": ">=8.0",
    "symfony/finder": ">=8.0",
    "symfony/http-client": ">=8.0",
    "symfony/http-foundation": ">=8.0",
    "symfony/http-kernel": ">=8.0",
    "symfony/options-resolver": ">=8.0",
    "symfony/password-hasher": ">=8.0",
    "symfony/property-access": ">=8.0",
    "symfony/property-info": ">=8.0",
    "symfony/routing": ">=8.0",
    "symfony/security-core": ">=8.0",
    "symfony/stopwatch": ">=8.0",
    "symfony/string": ">=8.0",
    "symfony/twig-bridge": ">=8.0",
    "symfony/type-info": ">=8.0",
    "symfony/var-dumper": ">=8.0",
    "symfony/var-exporter": ">=8.0",
    "symfony/dom-crawler": ">=8.0"
  },
  "suggest": {
    "pestphp/pest": "Optional testing syntax; choose a major compatible with the locked PHPUnit version in a reviewed dependency change."
  }
}
