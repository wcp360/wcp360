{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:wcp360:registry:candidate:0.1.0:response",
    "title": "WCP360 vendor Registry candidate 0.1.0 — metadata only",
    "$defs": {
        "Version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "Compatibility": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "core",
                "php",
                "api",
                "sdk",
                "os",
                "architectures"
            ],
            "properties": {
                "core": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                },
                "php": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                },
                "api": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                },
                "sdk": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                },
                "os": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "debian-12",
                            "debian-13",
                            "ubuntu-22.04",
                            "ubuntu-24.04",
                            "ubuntu-26.04"
                        ]
                    },
                    "maxItems": 5,
                    "minItems": 1
                },
                "architectures": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "amd64",
                            "arm64"
                        ]
                    },
                    "maxItems": 2,
                    "minItems": 1
                }
            }
        },
        "Distribution": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "status",
                "reason"
            ],
            "properties": {
                "status": {
                    "const": "unavailable"
                },
                "reason": {
                    "const": "metadata_only"
                }
            }
        },
        "Package": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "type",
                "slug",
                "name",
                "description",
                "author",
                "homepage",
                "pricing",
                "license",
                "tags",
                "latest_version"
            ],
            "properties": {
                "type": {
                    "type": "string",
                    "enum": [
                        "plugin",
                        "module",
                        "app",
                        "core"
                    ]
                },
                "slug": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80,
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                },
                "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                },
                "author": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                },
                "homepage": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 1024
                },
                "pricing": {
                    "type": "string",
                    "enum": [
                        "free",
                        "paid",
                        "trial",
                        "freemium",
                        "opensource"
                    ]
                },
                "license": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 160
                },
                "tags": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                    },
                    "maxItems": 20,
                    "minItems": 0
                },
                "latest_version": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/Version"
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            }
        },
        "Release": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "type",
                "slug",
                "version",
                "channel",
                "released_at",
                "changelog",
                "compatibility",
                "distribution"
            ],
            "properties": {
                "type": {
                    "type": "string",
                    "enum": [
                        "plugin",
                        "module",
                        "app",
                        "core"
                    ]
                },
                "slug": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80,
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "version": {
                    "$ref": "#/$defs/Version"
                },
                "channel": {
                    "type": "string",
                    "enum": [
                        "stable",
                        "beta",
                        "nightly"
                    ]
                },
                "released_at": {
                    "type": "string",
                    "minLength": 20,
                    "maxLength": 20,
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
                },
                "changelog": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 16000
                },
                "compatibility": {
                    "$ref": "#/$defs/Compatibility"
                },
                "distribution": {
                    "$ref": "#/$defs/Distribution"
                }
            }
        },
        "Pagination": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "page",
                "per_page",
                "total",
                "pages"
            ],
            "properties": {
                "page": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100000
                },
                "per_page": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 50
                },
                "total": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2000
                },
                "pages": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2000
                }
            }
        },
        "Status": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "service",
                "features"
            ],
            "properties": {
                "service": {
                    "const": "wcp360-registry"
                },
                "features": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "catalog",
                        "versions",
                        "update_checks",
                        "installation",
                        "downloads",
                        "license_validation",
                        "billing"
                    ],
                    "properties": {
                        "catalog": {
                            "const": true
                        },
                        "versions": {
                            "const": true
                        },
                        "update_checks": {
                            "const": true
                        },
                        "installation": {
                            "const": false
                        },
                        "downloads": {
                            "const": false
                        },
                        "license_validation": {
                            "const": false
                        },
                        "billing": {
                            "const": false
                        }
                    }
                }
            }
        },
        "Packages": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "items",
                "pagination"
            ],
            "properties": {
                "items": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/Package"
                    },
                    "maxItems": 50,
                    "minItems": 0
                },
                "pagination": {
                    "$ref": "#/$defs/Pagination"
                }
            }
        },
        "Releases": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "items",
                "pagination"
            ],
            "properties": {
                "items": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/Release"
                    },
                    "maxItems": 50,
                    "minItems": 0
                },
                "pagination": {
                    "$ref": "#/$defs/Pagination"
                }
            }
        },
        "Update": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "type",
                "slug",
                "current_version",
                "channel",
                "update_available",
                "recommended",
                "installation_available"
            ],
            "properties": {
                "type": {
                    "type": "string",
                    "enum": [
                        "plugin",
                        "module",
                        "app",
                        "core"
                    ]
                },
                "slug": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80,
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "current_version": {
                    "$ref": "#/$defs/Version"
                },
                "channel": {
                    "type": "string",
                    "enum": [
                        "stable",
                        "beta",
                        "nightly"
                    ]
                },
                "update_available": {
                    "type": "boolean"
                },
                "recommended": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/Release"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "installation_available": {
                    "const": false
                }
            }
        },
        "Error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "code",
                "message"
            ],
            "properties": {
                "code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                },
                "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                }
            }
        },
        "StatusEnvelope": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schema_version",
                "contract_status",
                "data"
            ],
            "properties": {
                "schema_version": {
                    "const": "0.1.0"
                },
                "contract_status": {
                    "const": "candidate"
                },
                "data": {
                    "$ref": "#/$defs/Status"
                }
            }
        },
        "PackageEnvelope": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schema_version",
                "contract_status",
                "data"
            ],
            "properties": {
                "schema_version": {
                    "const": "0.1.0"
                },
                "contract_status": {
                    "const": "candidate"
                },
                "data": {
                    "$ref": "#/$defs/Package"
                }
            }
        },
        "PackagesEnvelope": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schema_version",
                "contract_status",
                "data"
            ],
            "properties": {
                "schema_version": {
                    "const": "0.1.0"
                },
                "contract_status": {
                    "const": "candidate"
                },
                "data": {
                    "$ref": "#/$defs/Packages"
                }
            }
        },
        "ReleasesEnvelope": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schema_version",
                "contract_status",
                "data"
            ],
            "properties": {
                "schema_version": {
                    "const": "0.1.0"
                },
                "contract_status": {
                    "const": "candidate"
                },
                "data": {
                    "$ref": "#/$defs/Releases"
                }
            }
        },
        "UpdateEnvelope": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schema_version",
                "contract_status",
                "data"
            ],
            "properties": {
                "schema_version": {
                    "const": "0.1.0"
                },
                "contract_status": {
                    "const": "candidate"
                },
                "data": {
                    "$ref": "#/$defs/Update"
                }
            }
        },
        "ErrorEnvelope": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schema_version",
                "contract_status",
                "error"
            ],
            "properties": {
                "schema_version": {
                    "const": "0.1.0"
                },
                "contract_status": {
                    "const": "candidate"
                },
                "error": {
                    "$ref": "#/$defs/Error"
                }
            }
        }
    },
    "anyOf": [
        {
            "$ref": "#/$defs/StatusEnvelope"
        },
        {
            "$ref": "#/$defs/PackageEnvelope"
        },
        {
            "$ref": "#/$defs/PackagesEnvelope"
        },
        {
            "$ref": "#/$defs/ReleasesEnvelope"
        },
        {
            "$ref": "#/$defs/UpdateEnvelope"
        },
        {
            "$ref": "#/$defs/ErrorEnvelope"
        }
    ]
}
