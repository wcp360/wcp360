{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WCP360 locally managed staging trust candidate 0.1.0",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "keys"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "keys": {
      "type": "array", "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["keyid", "public_key", "publisher", "allowed_types", "slug_prefix", "not_before", "not_after", "revoked"],
        "properties": {
          "keyid": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "public_key": {"type": "string", "minLength": 43, "maxLength": 44},
          "publisher": {"type": "string", "maxLength": 80, "pattern": "^[a-z0-9][a-z0-9.-]*$"},
          "allowed_types": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"enum": ["plugin", "module", "app", "core"]}},
          "slug_prefix": {"type": "string", "pattern": "^[a-z0-9-]{0,80}$"},
          "not_before": {"$ref": "#/$defs/utc"},
          "not_after": {"$ref": "#/$defs/utc"},
          "revoked": {"type": "boolean"}
        }
      }
    }
  },
  "$defs": {"utc": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}},
  "$comment": "Local operator authority only. Runtime validates base64 32-byte Ed25519 public keys, SHA256 keyid binding, unique IDs and validity windows. No automatic trust from the network. Empty keys rejects every import. Private keys are forbidden by the exact field set."
}
