{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wcp360:app-deploy:authoring:recipe:0",
  "title": "WCP360 application recipe authoring draft",
  "description": "Local non-executable authoring format, not an approved SDK/API/IPC/package/trust contract. Every accepted document remains non-installable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "recipe_id",
    "recipe_version",
    "status",
    "installable",
    "source_entry",
    "application_version",
    "artifact",
    "releases",
    "runtime",
    "dependencies",
    "hosting",
    "configuration_schema",
    "secret_purposes",
    "data",
    "lifecycle",
    "qualification",
    "upstream_sources"
  ],
  "properties": {
    "$schema": {
      "enum": [
        "../../schemas/app-recipe.schema.json",
        "../../../schemas/app-recipe.schema.json"
      ]
    },
    "schema": {
      "const": "wcp360.app-deploy.recipe-draft/0"
    },
    "recipe_id": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^dev\\.app-deploy\\.[a-z][a-z0-9-]{0,63}$",
      "description": "Local development authoring identity, never a canonical managed-resource or operation ID."
    },
    "recipe_version": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^0\\.[0-9]+\\.[0-9]+-draft\\.[1-9][0-9]*$"
    },
    "status": {
      "const": "draft"
    },
    "installable": {
      "const": false
    },
    "source_entry": {
      "anyOf": [
        {
          "const": null
        },
        {
          "$ref": "#/$defs/source_entry"
        }
      ]
    },
    "application_version": {
      "const": null
    },
    "artifact": {
      "$ref": "#/$defs/unresolved_artifact"
    },
    "releases": {
      "const": []
    },
    "runtime": {
      "$ref": "#/$defs/unresolved_runtime"
    },
    "dependencies": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "hosting": {
      "$ref": "#/$defs/hosting"
    },
    "configuration_schema": {
      "const": "configuration.schema.json"
    },
    "secret_purposes": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 60,
        "pattern": "^[a-z][a-z0-9_]{0,59}$"
      }
    },
    "data": {
      "$ref": "#/$defs/data"
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "install",
        "configure",
        "update",
        "uninstall",
        "backup",
        "restore",
        "inspect",
        "reconcile"
      ],
      "properties": {
        "install": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "implementation",
            "provider_operation_ref",
            "document"
          ],
          "properties": {
            "implementation": {
              "const": "not_implemented"
            },
            "provider_operation_ref": {
              "const": null
            },
            "document": {
              "enum": [
                null,
                "lifecycle/install.md"
              ]
            }
          }
        },
        "configure": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "implementation",
            "provider_operation_ref",
            "document"
          ],
          "properties": {
            "implementation": {
              "const": "not_implemented"
            },
            "provider_operation_ref": {
              "const": null
            },
            "document": {
              "enum": [
                null,
                "lifecycle/configure.md"
              ]
            }
          }
        },
        "update": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "implementation",
            "provider_operation_ref",
            "document"
          ],
          "properties": {
            "implementation": {
              "const": "not_implemented"
            },
            "provider_operation_ref": {
              "const": null
            },
            "document": {
              "enum": [
                null,
                "lifecycle/update.md"
              ]
            }
          }
        },
        "uninstall": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "implementation",
            "provider_operation_ref",
            "document"
          ],
          "properties": {
            "implementation": {
              "const": "not_implemented"
            },
            "provider_operation_ref": {
              "const": null
            },
            "document": {
              "enum": [
                null,
                "lifecycle/uninstall.md"
              ]
            }
          }
        },
        "backup": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "implementation",
            "provider_operation_ref",
            "document"
          ],
          "properties": {
            "implementation": {
              "const": "not_implemented"
            },
            "provider_operation_ref": {
              "const": null
            },
            "document": {
              "enum": [
                null,
                "lifecycle/backup.md"
              ]
            }
          }
        },
        "restore": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "implementation",
            "provider_operation_ref",
            "document"
          ],
          "properties": {
            "implementation": {
              "const": "not_implemented"
            },
            "provider_operation_ref": {
              "const": null
            },
            "document": {
              "enum": [
                null,
                "lifecycle/restore.md"
              ]
            }
          }
        },
        "inspect": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "implementation",
            "provider_operation_ref",
            "document"
          ],
          "properties": {
            "implementation": {
              "const": "not_implemented"
            },
            "provider_operation_ref": {
              "const": null
            },
            "document": {
              "enum": [
                null,
                "lifecycle/inspect.md"
              ]
            }
          }
        },
        "reconcile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "implementation",
            "provider_operation_ref",
            "document"
          ],
          "properties": {
            "implementation": {
              "const": "not_implemented"
            },
            "provider_operation_ref": {
              "const": null
            },
            "document": {
              "enum": [
                null,
                "lifecycle/reconcile.md"
              ]
            }
          }
        }
      }
    },
    "qualification": {
      "$ref": "#/$defs/qualification"
    },
    "upstream_sources": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/upstream_source"
      }
    }
  },
  "$defs": {
    "source_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "category",
        "nature",
        "proposed_profile"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "nature": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "proposed_profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      }
    },
    "unresolved_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolution",
        "pinning_required",
        "locator",
        "sha256",
        "oci_digest",
        "source_revision",
        "build_context_sha256"
      ],
      "properties": {
        "resolution": {
          "const": "unresolved"
        },
        "pinning_required": {
          "const": true
        },
        "locator": {
          "const": null
        },
        "sha256": {
          "const": null
        },
        "oci_digest": {
          "const": null
        },
        "source_revision": {
          "const": null
        },
        "build_context_sha256": {
          "const": null
        }
      }
    },
    "unresolved_runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "provider_ref",
        "version",
        "provider_digest",
        "frankenphp_worker_enabled",
        "frankenphp_worker_adapter_ref",
        "qualified_extensions"
      ],
      "properties": {
        "family": {
          "enum": [
            "php",
            "native_http",
            "docker"
          ]
        },
        "provider_ref": {
          "const": null
        },
        "version": {
          "const": null
        },
        "provider_digest": {
          "const": null
        },
        "qualified_extensions": {
          "const": []
        },
        "frankenphp_worker_enabled": {
          "const": false
        },
        "frankenphp_worker_adapter_ref": {
          "const": null
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "candidates",
        "placement",
        "selected_version",
        "provider_digest",
        "required"
      ],
      "properties": {
        "role": {
          "enum": [
            "database",
            "cache",
            "internal_web_server",
            "language_runtime",
            "background_worker"
          ]
        },
        "candidates": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 60,
            "pattern": "^[a-z][a-z0-9_-]{0,59}$"
          },
          "minItems": 1
        },
        "placement": {
          "enum": [
            "unresolved",
            "hosted_service",
            "upstream_bundle",
            "native_runtime"
          ]
        },
        "selected_version": {
          "const": null
        },
        "provider_digest": {
          "const": null
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "hosting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topology_ref",
        "native_htaccess",
        "private_ingress_required",
        "preserve_upstream_web_server",
        "frankenphp_worker_support",
        "tls_ownership"
      ],
      "properties": {
        "topology_ref": {
          "const": null
        },
        "native_htaccess": {
          "enum": [
            "optional",
            "required",
            "not_applicable"
          ]
        },
        "private_ingress_required": {
          "const": true
        },
        "preserve_upstream_web_server": {
          "type": "boolean"
        },
        "tls_ownership": {
          "const": "future_core_managed_edge"
        },
        "frankenphp_worker_support": {
          "enum": [
            "not_qualified",
            "not_applicable"
          ]
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "persistent_roles",
        "retain_on_uninstall",
        "purge_policy",
        "owned_resources_only",
        "backup_consistency"
      ],
      "properties": {
        "persistent_roles": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "application_files",
              "database",
              "uploads",
              "application_configuration",
              "plugin_metadata",
              "object_storage"
            ]
          }
        },
        "retain_on_uninstall": {
          "const": true
        },
        "purge_policy": {
          "const": "separate_explicit_authorization"
        },
        "owned_resources_only": {
          "const": true
        },
        "backup_consistency": {
          "const": "application_specific_required"
        }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "publisher_trust_verified",
        "artifact_integrity_verified",
        "native_installation_implemented",
        "live_activation_implemented",
        "performance_measured",
        "qualified_targets",
        "evidence_scope"
      ],
      "properties": {
        "state": {
          "const": "candidate"
        },
        "publisher_trust_verified": {
          "const": false
        },
        "artifact_integrity_verified": {
          "const": false
        },
        "native_installation_implemented": {
          "const": false
        },
        "live_activation_implemented": {
          "const": false
        },
        "performance_measured": {
          "const": false
        },
        "qualified_targets": {
          "const": []
        },
        "evidence_scope": {
          "const": "upstream_documentation_only"
        }
      }
    },
    "upstream_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "checked_at",
        "purpose"
      ],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 12,
          "maxLength": 300,
          "pattern": "^https://[^\\s]+$"
        },
        "checked_at": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "minLength": 10,
          "maxLength": 10
        },
        "purpose": {
          "enum": [
            "requirements",
            "installation",
            "routing",
            "update",
            "backup_restore",
            "container_deployment"
          ]
        }
      }
    }
  }
}
