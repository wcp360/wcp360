{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wcp360:app-deploy:authoring:configuration:discourse:0",
  "title": "discourse candidate configuration input",
  "description": "Bounded authoring data only; no Core operation consumes this file. References require future authorized registry resolution. JSON Schema format annotations do not replace application validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "tenantRef",
    "hostingAccountRef",
    "domainRef",
    "containerProviderRef",
    "capacityProfileRef",
    "storageProfileRef",
    "adminEmails",
    "identityMode",
    "secretRefs"
  ],
  "properties": {
    "schema": {
      "const": "wcp360.app-deploy.configuration-draft/0"
    },
    "tenantRef": {
      "$ref": "#/$defs/resourceRef"
    },
    "hostingAccountRef": {
      "$ref": "#/$defs/resourceRef"
    },
    "domainRef": {
      "$ref": "#/$defs/resourceRef"
    },
    "containerProviderRef": {
      "$ref": "#/$defs/resourceRef"
    },
    "capacityProfileRef": {
      "$ref": "#/$defs/resourceRef"
    },
    "storageProfileRef": {
      "$ref": "#/$defs/resourceRef"
    },
    "adminEmails": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/email"
      }
    },
    "identityMode": {
      "enum": [
        "smtp",
        "discourse_id"
      ]
    },
    "smtpServiceRef": {
      "$ref": "#/$defs/resourceRef"
    },
    "secretRefs": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "smtpCredentials": {
          "$ref": "#/$defs/secretRef"
        },
        "databaseCredentials": {
          "$ref": "#/$defs/secretRef"
        },
        "redisCredentials": {
          "$ref": "#/$defs/secretRef"
        }
      }
    }
  },
  "$defs": {
    "resourceRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$",
      "description": "Opaque authoring reference only. The future Core must resolve and authorize the actual resource; a matching string is not a credential or permission."
    },
    "secretRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$",
      "description": "Opaque authoring reference only. The future Core must resolve and authorize the actual resource; a matching string is not a credential or permission."
    },
    "email": {
      "type": "string",
      "minLength": 3,
      "maxLength": 254,
      "format": "email",
      "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "identityMode": {
            "const": "smtp"
          }
        },
        "required": [
          "identityMode"
        ]
      },
      "then": {
        "required": [
          "smtpServiceRef"
        ],
        "properties": {
          "secretRefs": {
            "required": [
              "smtpCredentials"
            ]
          }
        }
      }
    }
  ]
}
