# Secrets and credentials
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.csr
*.jks
*.keystore
credentials*
secrets*
# Only named documentation pages may bypass the broad secrets-name rule.
# Their contents still require review; never store actual credentials here.
!/documentation/**/secrets.md
!/specifications/**/secrets.md
private/
.secret/
secrets/

# Runtime / local state
*.pid
*.sock
*.log
logs/
# Root runtime output only; do not hide nested source directories.
/runtime/
tmp/
temp/
cache/
var/
storage/private/

# Databases / backups / dumps
*.sql
# Source-only exceptions. These patterns create no SQL or migration files.
!/database/migrations/**/*.sql
!/tests/fixtures/**/*.sql
# Conventional dump names remain excluded, including inside source exceptions.
*.dump.sql
*.backup.sql
*.sql.gz
*.sql.bz2
*.sql.xz
*.dump
*.backup
*.bak
backups/
dumps/

# Dependencies / build outputs
node_modules/
vendor/
dist/
# Root build output only; keep packaging/build and tools/build trackable.
/build/
coverage/
.cache/
.phpunit.cache/
.pytest_cache/
__pycache__/
*.pyc

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local overrides
*.local
config/local/

# Local downloaded toolchains remain private/generated.
/WCP360_Build/build/
